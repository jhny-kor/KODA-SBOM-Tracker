limit_conn_zone $binary_remote_addr zone=sbom_upload_conn:10m;
limit_req_zone $binary_remote_addr zone=sbom_upload_rate:10m rate=5r/s;

server {
    resolver 127.0.0.11 valid=10s ipv6=off;
    listen 8080;
    server_name ${GATEWAY_SERVER_NAME};
    # Control-plane and authentication requests should stay small. Upload
    # routes opt into narrowly scoped larger limits below.
    client_max_body_size 64k;
    error_page 400 401 402 403 404 405 406 413 500 501 502 503 504 505 /__tracker_http_error.html;

    location = /__tracker_http_error.html {
        internal;
        alias /etc/nginx/tracker-http-error.html;
        add_header Cache-Control "no-store" always;
    }

    location = /api/v1/sbom-runs {
        # The API limits the file itself to 500 MiB; this extra MiB covers
        # multipart form fields and boundaries.
        client_max_body_size 501m;
        limit_conn sbom_upload_conn 2;
        limit_req zone=sbom_upload_rate burst=20 nodelay;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Prefix /api;
        proxy_pass http://${PORTAL_API_UPSTREAM};
    }

    # Large offline datasets stream to the bounded API upload spool.
    location = /api/v1/vulnerability-data-bundles/upload {
        client_max_body_size 2049m;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://${PORTAL_API_UPSTREAM};
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location ~ ^/api/v1/(package-metadata/import|vulnerability-intelligence/import)$ {
        client_max_body_size 65m;
        proxy_read_timeout 600s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://${PORTAL_API_UPSTREAM};
    }
    location = /api/v1/compatibility-data/import {
        # Allow a 16 MiB archive and 64 KiB of multipart overhead.
        client_max_body_size 16448k;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Prefix /api;
        proxy_pass http://${PORTAL_API_UPSTREAM};
    }
    location = /api/v1/upgrade-batches/import {
        client_max_body_size 1m;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Prefix /api;
        proxy_pass http://${PORTAL_API_UPSTREAM};
    }
    location = /api/v1/sbom-policies {
        client_max_body_size 1m;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://${PORTAL_API_UPSTREAM};
    }
    location = /api/v1/vulnerability-intelligence/import-csv {
        client_max_body_size 65m;
        proxy_request_buffering off;
        limit_conn sbom_upload_conn 2;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Prefix /api;
        proxy_pass http://${PORTAL_API_UPSTREAM}/api/v1/vulnerability-intelligence/import-csv;
    }

    location /api/v1/cve-catalog {
        # A cold offline catalog can take longer than the default 60 seconds.
        proxy_read_timeout 600s;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Prefix /api;
        proxy_pass http://${PORTAL_API_UPSTREAM}/api/v1/cve-catalog;
    }

    location /api/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Prefix /api;
        proxy_pass http://${PORTAL_API_UPSTREAM}/api/;
    }

    location = /api/v1/healthz {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://${PORTAL_API_UPSTREAM}/health;
    }

    location = /openapi.json { return 404; }
    location /docs { return 404; }
    location /redoc { return 404; }

    location / {
        # Preserve API response bodies by intercepting only the web upstream.
        proxy_intercept_errors on;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://${PORTAL_WEB_UPSTREAM}/;
    }
}
