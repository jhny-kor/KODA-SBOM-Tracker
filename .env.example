COMPOSE_PROJECT_NAME=koda-sbom
PUBLIC_HTTP_PORT=8088
GATEWAY_SERVER_NAME=_

POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
POSTGRES_INITDB_ARGS='--encoding=UTF-8 --locale=C.UTF-8'

DTRACK_DB_NAME=dtrack
DTRACK_DB_USER=dtrack
DTRACK_DB_PASSWORD=change-me-dtrack

TRACKER_DB_NAME=sbom_tracker
TRACKER_DB_USER=sbom_tracker
TRACKER_DB_PASSWORD=change-me-tracker

POSTGRES_DATA_VOLUME_NAME=koda-sbom-postgres-data
DTRACK_DATA_VOLUME_NAME=koda-sbom-dtrack-data
TRACKER_ARTIFACTS_VOLUME_NAME=koda-sbom-tracker-artifacts
VULN_DATA_VOLUME_NAME=koda-sbom-vuln-data
BACKUP_VOLUME_NAME=koda-sbom-backups

DTRACK_APISERVER_IMAGE=dependencytrack/apiserver:5.0.3@sha256:0cf15de2649d75ce4e7736b428d203f9630665d8bc843d15f0c6c5b23b56ada7
DTRACK_FRONTEND_IMAGE=dependencytrack/frontend:5.0.3@sha256:c8bb3f1b806f9ab2a854eec577a97a177d13befd488757f3ed61810d48ae6d9b
POSTGRES_IMAGE=postgres:16.10-alpine@sha256:029660641a0cfc575b14f336ba448fb8a75fd595d42e1fa316b9fb4378742297
NGINX_IMAGE=nginx:1.29.1-alpine@sha256:42a516af16b852e33b7682d5ef8acbd5d13fe08fecadc7ed98605ba5e3b26ab8
NODE_IMAGE=node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2
PYTHON_BASE_IMAGE=python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
ALPINE_BASE_IMAGE=alpine:3.22.1@sha256:4bcff63911fcb4448bd4fdacec207030997caf25e9bea4045fa6c8c44de311d1
GRYPE_IMAGE=anchore/grype:v0.109.1@sha256:5db068d57d48ee251726e6e2d4903f47a909371ed83b96ee4812d84a10288c65
CYCLONEDX_CLI_IMAGE=cyclonedx/cyclonedx-cli:0.30.0@sha256:8475ecf6c09d17dbb3b039d6999334d3ecf3aaed13395b3413007e568d52a9e3

PORTAL_WEB_IMAGE=local/koda-sbom-portal-web
PORTAL_API_IMAGE=local/koda-sbom-portal-api
PORTAL_WORKER_IMAGE=local/koda-sbom-portal-worker
PORTAL_IMAGE_TAG=dev

PORTAL_API_PORT=8000
PORTAL_WEB_PORT=8080
PORTAL_WORKER_HEARTBEAT_SECONDS=10
# Keep the API and gateway upload ceilings aligned (100 MiB).
UPLOAD_MAX_BYTES=104857600
ARTIFACT_ROOT=/var/lib/sbom-tracker/artifacts
VULN_DATA_ROOT=/var/lib/sbom-tracker/vuln-data
TRACKER_DATABASE_URL=postgresql+psycopg://sbom_tracker:change-me-tracker@postgres:5432/sbom_tracker
TRACKER_BOOTSTRAP_ADMIN_USERNAME=admin
TRACKER_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
TRACKER_SECURE_COOKIES=false
TRACKER_ENVIRONMENT=development
TRACKER_PUBLIC_ORIGIN=http://127.0.0.1:8088
TRACKER_DEPENDENCY_TRACK_URL=http://dtrack-apiserver:8080
TRACKER_DEPENDENCY_TRACK_API_KEY=change-me-dtrack-api-key
TRACKER_DEPENDENCY_TRACK_UI_URL=/dependency-track/
TRACKER_GRYPE_BINARY=grype
TRACKER_GRYPE_DB_DIR=/var/lib/sbom-tracker/vuln-data/current/grype-db

DTRACK_BASE_PATH=/dependency-track
# Browser-reachable Dependency-Track base; the frontend appends /api itself.
# For the integrated gateway use https://<host>/dependency-track (or the
# temporary HTTP equivalent), not .../dependency-track/api.
DTRACK_API_BASE_URL=http://localhost:8088/dependency-track
# Optional administrator/API automation base. This one includes /api.
DTRACK_ADMIN_API_BASE_URL=http://localhost:8088/dependency-track/api
DTRACK_FRONTEND_TITLE='KODA Dependency-Track'

BACKUP_ROOT=./backups
OFFLINE_BUNDLE_ROOT=./dist/offline-bundle
INCLUDE_ENV_IN_BACKUP=0
